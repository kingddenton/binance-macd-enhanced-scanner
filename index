
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Binance Enhanced MACD Crossover Scanner</title>
<style>
:root{color-scheme:light;--bg:#f4f7fb;--panel:#fff;--line:#dce4ee;--text:#17243a;--muted:#68778d;--green:#0b9b70;--red:#d9435f;--blue:#2563eb}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:14px/1.45 system-ui,sans-serif}
header{padding:20px;background:#fff;border-bottom:1px solid var(--line)}
h1{font-size:22px;margin:0 0 4px}
header p,.hint{color:var(--muted)}
main{padding:16px;max-width:1700px;margin:auto}
.panel,.result-panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:15px;margin-bottom:14px;box-shadow:0 2px 8px rgba(25,45,75,.045)}
.panel h2,.result-panel h2{font-size:16px;margin:0 0 12px}
.controls{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px}
label.field{display:flex;flex-direction:column;gap:5px;color:var(--muted);font-size:12px}
input,select{width:100%;background:#fff;color:var(--text);border:1px solid var(--line);border-radius:7px;padding:9px;font:inherit}
input[type=checkbox]{width:auto;accent-color:var(--blue)}
.checkgrid{display:flex;flex-wrap:wrap;gap:8px 13px}
.check{display:inline-flex;align-items:center;gap:6px;font-size:13px}
.rsi-list{display:grid;gap:6px;max-width:430px}
.rsi-row{display:grid;grid-template-columns:48px 24px 1fr 1fr;align-items:center;gap:8px;background:#f8fafd;border:1px solid var(--line);border-radius:7px;padding:5px 8px}
.rsi-row input[type=number]{padding:6px;min-width:0}
.rsi-row .tf{font-weight:650}
.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
button{border:0;border-radius:8px;padding:10px 15px;font-weight:650;cursor:pointer;background:var(--blue);color:#071326}
button.secondary{background:#e8eef6;color:#24344d}
button.stop{background:#b8324b;color:white}
button:disabled{opacity:.45;cursor:not-allowed}
.status{display:flex;flex-wrap:wrap;gap:14px;color:var(--muted);font-size:12px;margin-top:10px}
.progress{height:6px;background:#e3eaf3;border-radius:9px;overflow:hidden;margin-top:9px}
.progress span{display:block;height:100%;width:0;background:var(--blue)}
.filter-columns{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.results{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.result-panel{padding:0;min-width:0;overflow:hidden}
.result-panel h2{padding:12px 14px;margin:0}
.bull h2{color:var(--green)}
.bear h2{color:var(--red)}
.table-wrap{overflow:auto;max-height:65vh}
table{width:100%;border-collapse:collapse;font-size:12px;white-space:nowrap}
th,td{padding:8px 9px;border-top:1px solid var(--line);text-align:right}
th{position:sticky;top:0;background:#edf2f8;color:#52627a;z-index:1}
th:first-child,td:first-child{text-align:left}
td.pair{font-weight:700}
.positive{color:var(--green)}
.negative{color:var(--red)}
.empty{padding:22px;color:var(--muted);text-align:center}
footer{color:var(--muted);font-size:11px;padding:10px 2px}
@media(max-width:1000px){.filter-columns{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:700px){.filter-columns{grid-template-columns:1fr}.results{grid-template-columns:1fr}h1{font-size:19px}}
</style>
</head>
<body>
<header>
<h1>Binance Enhanced MACD Crossover Scanner</h1>
<p>USDⓈ-M perpetual futures · Public market data only · Scanner does not place trades</p>
</header>

<main>
<section class="panel">
<h2>1. Market and scan controls</h2>
<div class="controls">
<label class="field">Pairs to scan
<select id="universe">
<option value="50" selected>Top 50 by 24h quote volume</option>
<option value="100">Top 100</option>
<option value="200">Top 200</option>
<option value="all">All eligible USDT perpetuals</option>
</select>
</label>
<label class="field">Minimum 24h quote volume (USDT)
<input id="minVol" type="number" min="0" value="2000000">
</label>
<label class="field">MACD crossover baseline timeframe
<select id="baseTf"></select>
</label>
<label class="field">Auto refresh
<select id="refresh">
<option value="0">Off</option>
<option value="30" selected>Every 30 seconds</option>
<option value="60">Every 60 seconds</option>
<option value="120">Every 2 minutes</option>
<option value="300">Every 5 minutes</option>
</select>
</label>
</div>
<div class="actions">
<button id="startBtn">Start scanning</button>
<button id="onceBtn" class="secondary">Scan once</button>
<button id="stopBtn" class="stop" disabled>Stop</button>
<button id="clearBtn" class="secondary">Clear results</button>
<button id="csvBtn" class="secondary">Export CSV</button>
</div>
<div class="progress"><span id="progressBar"></span></div>
<div class="status">
<span id="status">Ready.</span>
<span id="count">0 bullish · 0 bearish</span>
<span id="updated">Not yet scanned</span>
</div>
</section>

<div class="filter-columns">
<section class="panel">
<h2>2. Histogram and DEA confirmations</h2>
<p class="hint">Every selected timeframe must confirm the crossover direction.</p>
<strong>Histogram timeframes</strong>
<div id="histTfs" class="checkgrid" style="margin:8px 0 14px"></div>
<strong>DEA timeframes</strong>
<div id="deaTfs" class="checkgrid" style="margin-top:8px"></div>
</section>

<section class="panel">
<h2>3. Supertrend and EMA</h2>
<p class="hint">Supertrend uses ATR(10), multiplier 3. EMA confirmation is optional.</p>
<strong>Supertrend timeframes</strong>
<div id="stTfs" class="checkgrid" style="margin:8px 0 14px"></div>
<label class="check">
<input id="emaOn" type="checkbox">
Require EMA 9 above EMA 21 for bullish / below for bearish
</label>
<div class="controls" style="margin-top:10px">
<label class="field">EMA timeframe<select id="emaTf"></select></label>
</div>
</section>

<section class="panel">
<h2>4. RSI filters by timeframe</h2>
<p class="hint">Enable any rows you want. Each enabled row must fall within its own minimum and maximum range.</p>
<div id="rsiRows" class="rsi-list"></div>
</section>
</div>

<div class="results">
<section class="result-panel bull">
<h2>▲ Bullish crossovers</h2>
<div class="table-wrap">
<table><thead id="bullHead"></thead><tbody id="bullBody"><tr><td class="empty">No results yet.</td></tr></tbody></table>
</div>
</section>

<section class="result-panel bear">
<h2>▼ Bearish crossovers</h2>
<div class="table-wrap">
<table><thead id="bearHead"></thead><tbody id="bearBody"><tr><td class="empty">No results yet.</td></tr></tbody></table>
</div>
</section>
</div>

<footer>
MACD uses standard 12 / 26 / 9 settings. Only completed candles are used.
Crossover Age is measured on the baseline timeframe and displayed from 1/10 through 10/10.
Histogram Count shows consecutive completed baseline candles with the current histogram direction, capped at 10.
Colored dots show bullish or bearish direction. Grey dashes mean a confirmation was not selected.
Supertrend uses ATR 10, multiplier 3. This tool is informational and does not place trades.
</footer>
</main>

<script>
"use strict";

const API="https://fapi.binance.com";
const TFS=["1m","3m","5m","10m","15m","30m","1h","2h","4h","6h","12h","1d"];
const $=id=>document.getElementById(id);

const state={
 running:false,
 timer:null,
 stop:false,
 lastBull:[],
 lastBear:[],
 scanId:0
};

function makeChecks(id,values){
 $(id).innerHTML=values.map(v=>
  '<label class="check"><input type="checkbox" value="'+v+'"> '+v+'</label>'
 ).join("");
}

function makeSelect(id,selected){
 $(id).innerHTML=TFS.map(v=>
  '<option '+(v===selected?"selected":"")+' value="'+v+'">'+v+'</option>'
 ).join("");
}

makeSelect("baseTf","5m");
makeSelect("emaTf","5m");
makeChecks("histTfs",TFS);
makeChecks("deaTfs",TFS);
makeChecks("stTfs",TFS);

$("rsiRows").innerHTML=TFS.map(tf=>
 '<div class="rsi-row">'+
 '<span class="tf">'+tf+'</span>'+
 '<input type="checkbox" class="rsi-enable" data-tf="'+tf+'" aria-label="Enable RSI '+tf+'">'+
 '<input type="number" class="rsi-min" data-tf="'+tf+'" placeholder="Min" min="0" max="100">'+
 '<input type="number" class="rsi-max" data-tf="'+tf+'" placeholder="Max" min="0" max="100">'+
 '</div>'
).join("");

const selected=id=>
 Array.from($(id).querySelectorAll("input:checked")).map(x=>x.value);

function rsiConfig(){
 return Array.from(document.querySelectorAll(".rsi-enable:checked")).map(x=>{
  const tf=x.dataset.tf;
  const min=document.querySelector('.rsi-min[data-tf="'+tf+'"]').value;
  const max=document.querySelector('.rsi-max[data-tf="'+tf+'"]').value;
  return {
   tf,
   min:min===""?0:Number(min),
   max:max===""?100:Number(max)
  };
 });
}

function checkedConfig(){
 return {
  base:$("baseTf").value,
  hist:selected("histTfs"),
  dea:selected("deaTfs"),
  st:selected("stTfs"),
  rsi:rsiConfig(),
  ema:$("emaOn").checked,
  emaTf:$("emaTf").value
 };
}

async function getJSON(url){
 const r=await fetch(url);
 if(!r.ok)throw new Error("HTTP "+r.status);
 return r.json();
}

function ema(values,period){
 const k=2/(period+1);
 const out=Array(values.length).fill(null);
 if(values.length<period)return out;

 let sum=0;
 for(let i=0;i<period;i++)sum+=values[i];

 let prev=sum/period;
 out[period-1]=prev;

 for(let i=period;i<values.length;i++){
  prev=values[i]*k+prev*(1-k);
  out[i]=prev;
 }
 return out;
}

function macd(closes){
 const e12=ema(closes,12);
 const e26=ema(closes,26);

 const dif=closes.map((_,i)=>
  e12[i]==null||e26[i]==null?null:e12[i]-e26[i]
 );

 const firstValid=dif.findIndex(v=>v!==null);
 const dea=Array(dif.length).fill(null);

 if(firstValid>=0){
  const validDif=dif.slice(firstValid);
  const calculated=ema(validDif,9);
  calculated.forEach((v,i)=>dea[firstValid+i]=v);
 }

 const hist=dif.map((v,i)=>
  v==null||dea[i]==null?null:v-dea[i]
 );

 return {dif,dea,hist};
}

function calcRSI(closes,period=14){
 if(closes.length<=period)return null;

 let gain=0,loss=0;

 for(let i=1;i<=period;i++){
  const d=closes[i]-closes[i-1];
  if(d>0)gain+=d;
  else loss-=d;
 }

 let ag=gain/period;
 let al=loss/period;

 for(let i=period+1;i<closes.length;i++){
  const d=closes[i]-closes[i-1];
  ag=(ag*(period-1)+Math.max(d,0))/period;
  al=(al*(period-1)+Math.max(-d,0))/period;
 }

 if(al===0)return 100;
 return 100-100/(1+ag/al);
}

function supertrend(candles,period=10,mult=3){
 if(candles.length<period+2)return null;

 const trs=[];

 for(let i=0;i<candles.length;i++){
  const p=candles[i-1];
  const c=candles[i];

  trs.push(i===0
   ?c.h-c.l
   :Math.max(c.h-c.l,Math.abs(c.h-p.c),Math.abs(c.l-p.c))
  );
 }

 let atr=trs.slice(0,period).reduce((a,b)=>a+b,0)/period;
 let upper=0,lower=0,trend=1;

 for(let i=period;i<candles.length;i++){
  atr=(atr*(period-1)+trs[i])/period;

  const mid=(candles[i].h+candles[i].l)/2;
  const basicUpper=mid+mult*atr;
  const basicLower=mid-mult*atr;

  if(i===period){
   upper=basicUpper;
   lower=basicLower;
   trend=candles[i].c>=mid?1:-1;
  }else{
   upper=basicUpper<candles[i-1].c||upper<candles[i-1].c
    ?basicUpper:upper;

   lower=basicLower>candles[i-1].c||lower>candles[i-1].c
    ?basicLower:lower;

   if(trend===1&&candles[i].c<lower)trend=-1;
   else if(trend===-1&&candles[i].c>upper)trend=1;
  }
 }

 return trend;
}

function crossoverAge(hist){
 if(hist.length<3)return null;

 const end=hist.length-1;
 const dir=hist[end]>0?"bull":hist[end]<0?"bear":null;

 if(!dir)return null;

 for(let i=end;i>=Math.max(1,end-9);i--){
  const prev=hist[i-1];
  const cur=hist[i];

  if(prev==null||cur==null)continue;

  if(dir==="bull"&&prev<=0&&cur>0)return end-i+1;
  if(dir==="bear"&&prev>=0&&cur<0)return end-i+1;
 }

 return null;
}

function setStatus(s){$("status").textContent=s;}

function setProgress(done,total){
 $("progressBar").style.width=
  (total?Math.min(100,done/total*100):0)+"%";
}

function fmt(v,d=6){
 if(v==null||!Number.isFinite(Number(v)))return "—";
 return Number(v).toLocaleString("en-US",{maximumFractionDigits:d});
}

function render(){
 const cols=[
  "Pair",
  "Crossover Age",
  "Histogram Count",
  "Histogram",
  "DEA",
  "Supertrend",
  "EMA",
  "RSI",
  "24h Change"
 ];

 for(const id of ["bullHead","bearHead"]){
  $(id).innerHTML="<tr>"+cols.map(c=>"<th>"+c+"</th>").join("")+"</tr>";
 }

 const row=x=>{
  const dot=(active,title)=>active
   ?'<span class="'+(x.dir==="bull"?"positive":"negative")+'" title="'+title+'">●</span>'
   :'<span style="color:#aab5c4" title="Not selected">—</span>';

  return '<tr><td class="pair">'+x.symbol+'</td>'+
   '<td>'+x.age+'/10</td>'+
   '<td>'+x.histCount+'/10</td>'+
   '<td>'+dot(true,"Baseline histogram "+x.dir)+'</td>'+
   '<td>'+dot(x.deaOn,"DIF/DEA confirmation")+'</td>'+
   '<td>'+dot(x.stOn,"Supertrend confirmation")+'</td>'+
   '<td>'+dot(x.emaOn,"EMA confirmation")+'</td>'+
   '<td>'+x.rsiText+'</td>'+
   '<td class="'+(x.change>=0?"positive":"negative")+'">'+(x.change>0?"+":"")+fmt(x.change,2)+'%</td></tr>';
 };

 $("bullBody").innerHTML=state.lastBull.length
  ?state.lastBull.map(row).join("")
  :'<tr><td class="empty" colspan="9">No bullish matches.</td></tr>';

 $("bearBody").innerHTML=state.lastBear.length
  ?state.lastBear.map(row).join("")
  :'<tr><td class="empty" colspan="9">No bearish matches.</td></tr>';

 $("count").textContent=
  state.lastBull.length+" bullish · "+state.lastBear.length+" bearish";
}

async function pool(items,limit,fn,onDone){
 let next=0,done=0;

 async function worker(){
  while(next<items.length&&!state.stop){
   const i=next++;

   try{await fn(items[i],i);}
   catch(e){}

   done++;
   if(onDone)onDone(done,items.length);
  }
 }

 await Promise.all(
  Array.from({length:Math.min(limit,items.length)},worker)
 );
}

async function analyzeSymbol(ticker,cfg){
 const symbol=ticker.symbol;

 const needed=[...new Set([
  cfg.base,
  ...cfg.hist,
  ...cfg.dea,
  ...cfg.st,
  ...cfg.rsi.map(x=>x.tf),
  ...(cfg.ema?[cfg.emaTf]:[])
 ])];

 const cache={};

 await pool(needed,3,async tf=>{
  const raw=await getJSON(
   API+"/fapi/v1/klines?symbol="+symbol+"&interval="+tf+"&limit=120"
  );

  const closed=raw.slice(0,-1).map(k=>({
   t:k[0],o:+k[1],h:+k[2],l:+k[3],c:+k[4],v:+k[5]
  }));

  cache[tf]=closed;
 });

 const base=cache[cfg.base];
 if(!base||base.length<40)return null;

 const baseCl=base.map(x=>x.c);
 const bm=macd(baseCl);
 const age=crossoverAge(bm.hist);

 if(age==null||age>10)return null;

 const dir=bm.hist[bm.hist.length-1]>0?"bull":"bear";
 const last=base.length-1;

 let histCount=0;
 for(let i=bm.hist.length-1;i>=0&&histCount<10;i--){
  const h=bm.hist[i];
  if(h==null||(dir==="bull"?h<=0:h>=0))break;
  histCount++;
 }

 const confirm=[];

 for(const tf of cfg.hist){
  const m=macd(cache[tf].map(x=>x.c));
  const h=m.hist.at(-1);

  if(h==null||(dir==="bull"?h<=0:h>=0))return null;
  confirm.push("Hist "+tf);
 }

 for(const tf of cfg.dea){
  const m=macd(cache[tf].map(x=>x.c));
  const d=m.dif.at(-1);
  const e=m.dea.at(-1);

  if(d==null||e==null||(dir==="bull"?d<=e:d>=e))return null;
  confirm.push("DEA "+tf);
 }

 for(const tf of cfg.st){
  const trend=supertrend(cache[tf]);

  if(trend==null||(dir==="bull"?trend!==1:trend!==-1))return null;
  confirm.push("ST "+tf);
 }

 const rsiVals=[];

 for(const f of cfg.rsi){
  const v=calcRSI(cache[f.tf].map(x=>x.c));

  if(v==null||v<f.min||v>f.max)return null;
  rsiVals.push(f.tf+":"+v.toFixed(1));
 }

 if(cfg.ema){
  const cl=cache[cfg.emaTf].map(x=>x.c);
  const e9=ema(cl,9).at(-1);
  const e21=ema(cl,21).at(-1);

  if(e9==null||e21==null||
    (dir==="bull"?e9<=e21:e9>=e21))return null;

  confirm.push("EMA "+cfg.emaTf);
 }

 return {
  symbol,
  dir,
  age,
  histCount,
  deaOn:cfg.dea.length>0,
  stOn:cfg.st.length>0,
  emaOn:cfg.ema,
  rsiText:rsiVals.length?rsiVals.join(" · "):"—",
  change:+ticker.priceChangePercent
 };
}

async function runScan(){
 if(state.running)return;

 state.running=true;
 state.stop=false;
 const myId=++state.scanId;

 $("startBtn").disabled=true;
 $("onceBtn").disabled=true;
 $("stopBtn").disabled=false;

 setProgress(0,1);
 setStatus("Loading Binance futures market…");

 try{
  const [info,tickers]=await Promise.all([
   getJSON(API+"/fapi/v1/exchangeInfo"),
   getJSON(API+"/fapi/v1/ticker/24hr")
  ]);

  const active=new Set(
   info.symbols
    .filter(s=>s.contractType==="PERPETUAL"&&
      s.quoteAsset==="USDT"&&s.status==="TRADING")
    .map(s=>s.symbol)
  );

  const minVol=Math.max(0,Number($("minVol").value)||0);

  let eligible=tickers
   .filter(t=>active.has(t.symbol)&&Number(t.quoteVolume)>=minVol)
   .sort((a,b)=>Number(b.quoteVolume)-Number(a.quoteVolume));

  const n=$("universe").value;
  if(n!=="all")eligible=eligible.slice(0,Number(n));

  const cfg=checkedConfig();

  state.lastBull=[];
  state.lastBear=[];
  render();

  setStatus("Scanning "+eligible.length+" pairs…");

  await pool(eligible,6,async t=>{
   if(state.stop||myId!==state.scanId)return;

   const result=await analyzeSymbol(t,cfg);

   if(result){
    (result.dir==="bull"?state.lastBull:state.lastBear).push(result);

    state.lastBull.sort((a,b)=>a.age-b.age);
    state.lastBear.sort((a,b)=>a.age-b.age);

    render();
   }
  },(d,total)=>{
   setProgress(d,total);
   setStatus("Scanning "+d+" / "+total+" pairs…");
  });

  if(myId===state.scanId){
   render();
   $("updated").textContent="Updated "+new Date().toLocaleTimeString();
   setStatus(state.stop?"Scan stopped.":"Scan complete.");
  }

 }catch(e){
  setStatus("Scan error: "+e.message+
   " (Binance API or network may be unavailable).");
 }finally{
  state.running=false;
  $("startBtn").disabled=false;
  $("onceBtn").disabled=false;
  $("stopBtn").disabled=true;
 }
}

function stopScan(){
 state.stop=true;
 state.scanId++;
 setStatus("Stopping scan…");
}

function schedule(){
 if(state.timer)clearInterval(state.timer);

 const seconds=Number($("refresh").value);

 if(state.running)stopScan();

 if(seconds>0){
  state.timer=setInterval(()=>{
   if(!state.running)runScan();
  },seconds*1000);
 }else{
  state.timer=null;
 }
}

$("startBtn").addEventListener("click",()=>{
 schedule();
 if(!state.running)runScan();
});

$("onceBtn").addEventListener("click",()=>{
 if(state.timer){
  clearInterval(state.timer);
  state.timer=null;
 }
 runScan();
});

$("stopBtn").addEventListener("click",()=>{
 stopScan();
 if(state.timer){
  clearInterval(state.timer);
  state.timer=null;
 }
});

$("refresh").addEventListener("change",schedule);

$("clearBtn").addEventListener("click",()=>{
 state.lastBull=[];
 state.lastBear=[];
 render();
 setStatus("Results cleared.");
});

$("csvBtn").addEventListener("click",()=>{
 const rows=[...state.lastBull,...state.lastBear];

 if(!rows.length){
  setStatus("There are no results to export.");
  return;
 }

 const headers=[
  "symbol","direction","crossover_age","histogram_count",
  "histogram_signal","dea_confirmation","supertrend_confirmation",
  "ema_confirmation","rsi","change_percent"
 ];

 const csv=[
  headers.join(","),
  ...rows.map(x=>[
   x.symbol,x.dir,x.age+"/10",x.histCount+"/10",x.dir,
   x.deaOn,x.stOn,x.emaOn,'"'+x.rsiText+'"',x.change
  ].join(","))
 ].join("\n");

 const a=document.createElement("a");
 a.href=URL.createObjectURL(
  new Blob([csv],{type:"text/csv"})
 );
 a.download="macd-scanner-results.csv";
 a.click();
 URL.revokeObjectURL(a.href);
});

render();
</script>
</body>
</html>
